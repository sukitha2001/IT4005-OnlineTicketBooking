<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — TicketBook</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="brand">🎟️ TicketBook</a>
    <ul class="nav-links">
      <li><a href="/events">Browse Events</a></li>
      <% if (locals.user) { %>
        <% if (user.role === 'CUSTOMER') { %>
          <li><a href="/customer/bookings">My Bookings</a></li>
          <li><a href="/customer/profile">Profile</a></li>
        <% } %>
        <% if (user.role === 'ORGANIZER') { %>
          <li><a href="/organizer/events">My Events</a></li>
        <% } %>
        <% if (user.role === 'SYSTEM_ADMIN') { %>
          <li><a href="/admin/dashboard">Admin Panel</a></li>
        <% } %>
        <li>
          <form action="/logout" method="POST" style="display:inline">
            <button type="submit" class="btn-link">Logout (<%= user.name %>)</button>
          </form>
        </li>
      <% } else { %>
        <li><a href="/login">Login</a></li>
        <li><a href="/register">Register</a></li>
      <% } %>
    </ul>
  </nav>
  <main class="container">
    <% if (locals.success && success && success.length) { %>
      <div class="alert alert-success" role="alert"><%= success[0] %></div>
    <% } %>
    <% if (locals.error && error && error.length) { %>
      <div class="alert alert-error" role="alert"><%= error[0] %></div>
    <% } %>
    <%- body %>
  </main>
  <footer class="footer">
    <p>&copy; 2026 TicketBook — IT4005 Advanced Software Engineering</p>
  </footer>
  <script src="/js/confirmDialog.js"></script>
</body>
</html>
