<%- include('../layouts/header', { title, user }) %>
<div class="page-header">
  <h1>My Profile</h1>
</div>
<div class="card">
  <form action="/customer/profile" method="POST">
    <div class="form-group">
      <label for="name">Full Name</label>
      <input type="text" id="name" name="name" value="<%= user.name %>" required maxlength="120">
    </div>
    <div class="form-group">
      <label for="email">Email Address</label>
      <input type="email" id="email" name="email" value="<%= user.email %>" required>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
  </form>
  <div class="profile-info">
    <p><strong>Role:</strong> <%= user.role %></p>
    <p><strong>Account Status:</strong> <span class="badge badge--<%= user.status.toLowerCase() %>"><%= user.status %></span></p>
  </div>
</div>
<%- include('../layouts/footer') %>
