<%- include('../layouts/header', { title, user }) %>
<div class="page-header">
  <h1>Audit Logs</h1>
</div>

<div class="table-responsive">
  <table class="data-table">
    <thead>
      <tr>
        <th>Timestamp</th>
        <th>Action</th>
        <th>Actor</th>
        <th>Entity Type</th>
        <th>Entity ID</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% if (logs.length === 0) { %>
        <tr><td colspan="6" class="text-center">No logs found.</td></tr>
      <% } %>
      <% logs.forEach(function(log) { %>
        <tr>
          <td><%= new Date(log.createdAt).toLocaleString('en-LK') %></td>
          <td><strong><%= log.action %></strong></td>
          <td>
            <% if (log.actorId) { %>
              User #<%= log.actorId %>
            <% } else { %>
              <em>System</em>
            <% } %>
          </td>
          <td><%= log.entityType || '-' %></td>
          <td><%= log.entityId || '-' %></td>
          <td class="log-details"><pre><%= log.details ? JSON.stringify(JSON.parse(log.details), null, 2) : '-' %></pre></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('../layouts/footer') %>
